#define g_get_node_mask(node_index) \
    (g_nodes[nonuniformEXT(pc.node_id)].data[(node_index)])

#define g_get_child_index(node_index) \
    (g_child_indices[nonuniformEXT(pc.child_id)].data[(node_index)])

bool traverse_one_chunk(
        Ray ray,
        vec3 chunk_min,
        out vec3 hit_pos,
        out uint hit_level,
        out uint hit_slot,
        out uint iter_count,
        out uint err_code,
        out vec3 hit_color)
{
        hit_pos = vec3(0.0);
        hit_level = 0u;
        hit_slot = 0u;
        iter_count = 0u;
        err_code = TRACE_OK;

        const int max_iter = 4096;
        const int STACK_CAP = TREE_LEVELS + 1;
        const uint NODE_STEP_CAP = 256u; // 4x4x4 is 64, cap higher for eps/boundary cases
        const int STUCK_LIMIT = 64; // how many consecutive "no progress" steps allowed

        uint levels = uint(TREE_LEVELS);

        float chunk_size = float(CHUNK_SIZE);
        vec3 chunk_max = chunk_min + vec3(chunk_size);

        float t0, t1;
        if (!ray_aabb(ray.origin, ray.dir, chunk_min, chunk_max, t0, t1)) {
                err_code = TRACE_OK; // MISS, not error
                return false;
        }
        // Ray dir sanity
        if (all(lessThan(abs(ray.dir), vec3(1e-12)))) {
                err_code = TRACE_ERR_DIR_ZERO;
                return false;
        }
        if (any(isnan(ray.dir)) || any(isinf(ray.dir)) ||
                        any(isnan(ray.origin)) || any(isinf(ray.origin))) {
                err_code = TRACE_ERR_DIR_NAN_INF;
                return false;
        }
        TraverseFrame stack[STACK_CAP];
        int stack_top = 0;

        float cur_t_base = max(t0, 0.0);

        TraverseFrame cur;
        cur.node_index = 0u;
        cur.level = 0u;
        cur.node_min = chunk_min;
        cur.node_size = chunk_size;
        cur.t_base = cur_t_base;
        cur.steps_in_node = 0u;

        if (!init_node_dda(ray, cur.node_min, cur.node_size, cur_t_base, cur.dda)) {
                err_code = TRACE_ERR_INIT_NODE_FAIL;
                return false;
        }

        RayTraceConstState cs;
        cs.step_dir_i32 = ivec3(sign(ray.dir));

        int stuck_count = 0;

        for (int iter = 0; iter < max_iter; ++iter)
        {
                iter_count = uint(iter);

                // DDA state sanity
                if (any(isnan(cur.dda.side_dist)) || any(isinf(cur.dda.side_dist)) ||
                                any(isnan(cur.dda.delta_dist)) || any(isinf(cur.dda.delta_dist)) ||
                                isnan(cur.dda.t_tot) || isinf(cur.dda.t_tot)) {
                        err_code = TRACE_ERR_DDA_NAN_INF;
                        return false;
                }

                // Ascend while out of bounds (leaving node volume)
                while (cur.dda.out_of_bounds)
                {
                        // If we pop above root => we exited the chunk: MISS (not an error)
                        if (stack_top == 0) {
                                err_code = TRACE_OK;
                                return false;
                        }

                        // restore parent
                        cur = stack[--stack_top];
                        cur_t_base = cur.t_base;

                        // step parent once to move to next cell after the child we just exhausted
                        uint64_t parent_mask = g_get_node_mask(cur.node_index);
                        cs.occupancy_mask = parent_mask;

                        ivec3 prev_pos = cur.dda.local_pos;
                        vec3 prev_side = cur.dda.side_dist;
                        float prev_t = cur.dda.t_tot;

                        dda_step(cur.dda, cs);
                        cur.steps_in_node++;

                        if (cur.steps_in_node > NODE_STEP_CAP) {
                                err_code = TRACE_ERR_NODE_STEP_CAP;
                                return false;
                        }

                        bool no_change =
                                all(equal(cur.dda.local_pos, prev_pos)) &&
                                        all(equal(cur.dda.side_dist, prev_side)) &&
                                        (cur.dda.t_tot == prev_t);

                        if (no_change) {
                                stuck_count++;
                                if (stuck_count > STUCK_LIMIT) {
                                        err_code = TRACE_ERR_DDA_STUCK;
                                        return false;
                                }
                        } else {
                                stuck_count = 0;
                        }
                }

                if (cur.level >= levels) {
                        err_code = TRACE_ERR_LEVEL_OOB;
                        return false;
                }

                uint64_t mask = g_get_node_mask(cur.node_index);
                uint packed = g_get_child_index(cur.node_index);

                bool level_leaf = (cur.level == (levels - 1u));
                bool early_leaf = childindex_is_leaf(packed);

                // local_pos must always be within 0..3 while in-bounds
                if (any(lessThan(cur.dda.local_pos, ivec3(0))) ||
                                any(greaterThan(cur.dda.local_pos, ivec3(3)))) {
                        err_code = TRACE_ERR_DDA_NAN_INF;
                        return false;
                }

                uint slot = get_local_index_from_vec3(cur.dda.local_pos);
                bool cell_occupied = child_present(mask, slot);

                // Leaf interpretation: mask bits are final occupancy at this node
                if (level_leaf || early_leaf)
                {
                        if (cell_occupied)
                        {
                                float t_hit = cur_t_base + cur.dda.t_tot;
                                hit_pos = ray.origin + t_hit * ray.dir;
                                hit_level = cur.level;
                                hit_slot = slot;
                                err_code = TRACE_OK;

                                // 1. Get the Base Index from the node
                                uint base_idx = packed & INDEX_MASK;

                                // 2. Create a mask of all bits LOWER than the current slot
                                //    (e.g. if slot is 3, we want bits 0, 1, and 2)
                                //    (1ULL << slot) - 1 creates a mask of 1s below the bit.
                                uint64_t lower_mask = (u64(1) << slot) - u64(1);

                                // 3. Count how many bits are set in the node mask *before* our slot
                                //    This tells us how many materials we need to skip to get to ours.
                                //    We mask the node's occupancy mask with the lower_mask.
                                uint offset = popcount64(mask & lower_mask);

                                // 4. Final Index = Base + Offset
                                uint final_mat_idx = base_idx + offset;

                                // 5. Fetch Material
                                uint mat_id = GET_LEAF_MATERIAL(pc.leaf_mats_id, final_mat_idx);
                              //  uint mat_id = g_leaf_mats[nonuniformEXT(pc.leaf_mats_id)].data[final_mat_idx];

                                // 6. Color lookup
                                hit_color = u32_rgb8_to_vec3(g_palette[nonuniformEXT(pc.palette_id)].data[mat_id]);

                                return true;
                        }
                }
                else if (cell_occupied)
                {
                        uint child_index;
                        if (node_get_child_index(mask, packed, slot, child_index))
                        {
                                if (stack_top >= STACK_CAP) {
                                        err_code = TRACE_ERR_STACK_OVERFLOW;
                                        return false;
                                }
                                if (child_index == cur.node_index) {
                                        err_code = TRACE_ERR_CHILD_SELF_LOOP;
                                        return false;
                                }
                                cur.t_base = cur_t_base;

                                // push parent frame as-is
                                stack[stack_top++] = cur;

                                float child_size = cur.node_size * 0.25;
                                vec3 child_min = cur.node_min + vec3(cur.dda.local_pos) * child_size;
                                float child_t_base = cur_t_base + cur.dda.t_tot;

                                // descend
                                cur.node_index = child_index;
                                cur.level = cur.level + 1u;
                                cur.node_min = child_min;
                                cur.node_size = child_size;
                                cur.t_base = child_t_base;
                                cur.steps_in_node = 0u;

                                cur_t_base = child_t_base;

                                if (!init_node_dda(ray, cur.node_min, cur.node_size, cur_t_base, cur.dda))
                                {
                                        // This is a real failure of your epsilon/inside logic at that node
                                        err_code = TRACE_ERR_INIT_NODE_FAIL;

                                        // Must be able to recover to parent safely
                                        if (stack_top == 0) return false;

                                        cur = stack[--stack_top];
                                        cur_t_base = cur.t_base;

                                        // keep going from parent (do not 'continue' into child)
                                }
                                else
                                {
                                        // start loop on the child
                                        continue;
                                }
                        }
                }

                // Step inside current node
                cs.occupancy_mask = mask;

                ivec3 prev_pos = cur.dda.local_pos;
                vec3 prev_side = cur.dda.side_dist;
                float prev_t = cur.dda.t_tot;

                dda_step(cur.dda, cs);
                cur.steps_in_node++;

                if (cur.steps_in_node > NODE_STEP_CAP) {
                        err_code = TRACE_ERR_NODE_STEP_CAP;
                        return false;
                }

                bool no_change =
                        all(equal(cur.dda.local_pos, prev_pos)) &&
                                all(equal(cur.dda.side_dist, prev_side)) &&
                                (cur.dda.t_tot == prev_t);

                if (no_change) {
                        stuck_count++;
                        if (stuck_count > STUCK_LIMIT) {
                                err_code = TRACE_ERR_DDA_STUCK;
                                return false;
                        }
                } else {
                        stuck_count = 0;
                }
        }

        err_code = TRACE_ERR_MAX_ITER;
        iter_count = uint(max_iter);
        return false;
}

vec4 debug_view_color(
        uint debug_mode,
        bool hit,
        uint iter_count,
        uint max_iter,
        uint hit_level,
        uint hit_slot,
        uint err_code, vec3 hit_color)
{
        if (debug_mode == DEBUG_MODE_HIT) {
                return hit ? vec4(hit_color, 1) : vec4(0, 0.5, 0, 1);
        }
        if (debug_mode == DEBUG_MODE_ITER_GRAY) {
                float t = clamp(float(iter_count) / max(1.0, float(max_iter)), 0.0, 1.0);
                return vec4(vec3(t), 1.0);
        }

        if (debug_mode == DEBUG_MODE_LEVEL) {
                // scale by TREE_LEVELS
                float t = hit ? (float(hit_level) / max(1.0, float(TREE_LEVELS - 1))) : 0.0;
                return vec4(vec3(t), 1.0);
        }

        if (debug_mode == DEBUG_MODE_ITER_GRAY_HIT_GREEN) {
                float t = clamp(float(iter_count) / max(1.0, float(max_iter)), 0.0, 1.0);
                vec3 c = vec3(t);
                return vec4(c, 1.0);
        }
        if (debug_mode == DEBUG_MODE_ERRORS) {
                // show error colors; if no error and hit, show green; if no error and miss, black
                return trace_error_color(err_code);
        }

        // fallback
        return vec4(0, 0, 0, 1);
}
